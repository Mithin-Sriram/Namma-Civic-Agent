# Database
DATABASE_URL="mongodb://localhost:27017/namma-civic-agent?replicaSet=rs0"

# OpenRouter
OPENROUTER_API_KEY="sk-or-v1-..."

# App URL (optional)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Microsoft Clarity (optional analytics)
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# Kestra (optional - workflow automation)
KESTRA_URL="http://localhost:8080"
KESTRA_AUTH=""

# Oumi (optional - fine-tuned model)
OUMI_ENABLED="false"
OUMI_MODEL_URL=""
OUMI_API_KEY=""
OUMI_COMMAND="oumi"
OUMI_TRAINING_TIMEOUT="7200000"

# RAG (Retrieval-Augmented Generation)
# Secret to protect the /api/rag/ingest and /api/rag/search endpoints
# In development with no secret set, routes are open. Set in production.
RAG_INGEST_SECRET="your-rag-secret-here"
